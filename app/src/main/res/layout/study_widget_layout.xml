<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_gradient_background"
    android:padding="16dp">

    <!-- Header Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="StudyMate Pro"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:id="@+id/widget_streak_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/widget_accent_pill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/widget_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥 Streak: --"
                android:textColor="#0C0824"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Dynamic Information grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Container: Tasks & Study -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:orientation="vertical"
            android:layout_marginRight="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_card_background"
                android:padding="8dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PENDING TO-DO"
                    android:textColor="#8E75FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_tasks_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📝 -- tasks left"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold" />

                <!-- Interactive task rows -->
                <LinearLayout
                    android:id="@+id/widget_todo_row_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/widget_todo_check_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☐"
                        android:textColor="#8E75FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingRight="6dp" />
                    <TextView
                        android:id="@+id/widget_todo_text_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Task 1"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_todo_row_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/widget_todo_check_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☐"
                        android:textColor="#8E75FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingRight="6dp" />
                    <TextView
                        android:id="@+id/widget_todo_text_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Task 2"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_todo_row_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/widget_todo_check_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☐"
                        android:textColor="#8E75FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingRight="6dp" />
                    <TextView
                        android:id="@+id/widget_todo_text_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Task 3"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_card_background"
                android:padding="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="UPCOMING PLANNING"
                    android:textColor="#8E75FF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_upcoming_event"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 No upcoming study"
                    android:textColor="#EFEFEF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Container: Pomodoro active display -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:background="@drawable/widget_card_background"
            android:padding="10dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POMODORO FOCUS"
                android:textColor="#8E75FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/widget_pomodoro_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ INACTIVE"
                android:textColor="#B0B0CB"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/widget_pomodoro_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25:00"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
